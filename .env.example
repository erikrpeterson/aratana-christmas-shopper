# Optional API keys for live product search
# Get BRAVE_API_KEY from https://brave.com/search/api/
# Get SERPAPI_KEY from https://serpapi.com/
BRAVE_API_KEY=
SERPAPI_KEY=

# Access password gate (required when exposing the app to the internet)
ACCESS_PASSWORD=your-access-password-here

# Secret key for Flask session cookies (set to a random string)
FLASK_SECRET_KEY=random-secret-string-keep-it-secret